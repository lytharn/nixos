# nix-direnv cache.
/.direnv/

# Generated by the dev shell for lua-language-server (Hyprland `hl` stubs).
/modules/home/apps/hyprland/.luarc.json

# Generated by the dev shell for lua-language-server (Neovim config: vim/Snacks
# globals + runtime type stubs).
/modules/home/apps/neovim/config/.luarc.json

# Generated by the dev shell: union of the two above, for tools that open the
# repo root as their LSP workspace (lua-language-server reads only the root
# .luarc.json and has no include mechanism).
/.luarc.json
